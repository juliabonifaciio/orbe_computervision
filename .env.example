# Copie para .env e ajuste conforme necessário. Nenhuma chave é obrigatória.
ORBE_SECRET_KEY=troque-esta-chave
ORBE_MODEL_PATH=models/modelo_visao.pt     # modelo treinado pelo grupo (opcional)
ORBE_FALLBACK_MODEL=yolo11s.pt             # modelo genérico COCO usado se o acima não existir
ORBE_MODEL_FAMILY=yolo                     # yolo | rtdetr
ORBE_IMGSZ=640
ORBE_DEVICE=                               # vazio = automático; "cpu" ou "0" para GPU
ORBE_MAX_UPLOAD_MB=10
# Integração opcional com LLM (desligada por padrão; o sistema funciona sem ela)
ORBE_LLM_PROVIDER=none                     # none | openai_compatible
ORBE_LLM_BASE_URL=
ORBE_LLM_API_KEY=
ORBE_LLM_MODEL=
